{
  "agent_id": "claude_code_sonnet_ponytail",
  "display_name": "Sonnet 4.6 + ponytail plugin 5.0.0, isolated",
  "kind": "cli_agent",
  "provider": "claude",
  "model": "claude-sonnet-4-6",
  "model_resolution": "configured",
  "command_template": [
    "claude",
    "--print",
    "--output-format",
    "json",
    "--dangerously-skip-permissions",
    "--disallowedTools",
    "WebSearch",
    "WebFetch",
    "--model",
    "claude-sonnet-4-6",
    "--effort",
    "high",
    "--setting-sources",
    "project,local",
    "--disable-slash-commands",
    "--plugin-dir",
    "<PATH-TO-PONYTAIL-V5.0.0-CHECKOUT>"
  ],
  "supports_stdin_prompt": true,
  "supports_workspace_cwd": true,
  "final_submission_mode": "process_exit",
  "default_timeout_seconds": 900,
  "env": {}
}
