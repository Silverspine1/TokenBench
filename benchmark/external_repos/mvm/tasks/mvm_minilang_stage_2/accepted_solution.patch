diff --git a/minilang/ast.go b/minilang/ast.go
new file mode 100644
index 0000000..ffc613b
--- /dev/null
+++ b/minilang/ast.go
@@ -0,0 +1,72 @@
+package minilang
+
+// stmt is a single executable statement.
+type stmt interface {
+	isStmt()
+}
+
+// letStmt binds the value of expr to a variable name.
+type letStmt struct {
+	name string
+	expr expr
+}
+
+func (*letStmt) isStmt() {}
+
+// printStmt evaluates expr and emits a line of output.
+type printStmt struct {
+	expr expr
+}
+
+func (*printStmt) isStmt() {}
+
+// expr is an evaluable expression node.
+type expr interface {
+	isExpr()
+}
+
+// intLit is a non-negative integer literal.
+type intLit struct {
+	value int
+}
+
+func (*intLit) isExpr() {}
+
+// strLit is a string literal with its escapes already decoded.
+type strLit struct {
+	value string
+}
+
+func (*strLit) isExpr() {}
+
+// varRef references a previously bound variable.
+type varRef struct {
+	name string
+}
+
+func (*varRef) isExpr() {}
+
+// unaryExpr is a prefix operator applied to one operand.
+type unaryExpr struct {
+	op      tokenKind
+	operand expr
+}
+
+func (*unaryExpr) isExpr() {}
+
+// binaryExpr is an infix operator applied to two operands.
+type binaryExpr struct {
+	op    tokenKind
+	left  expr
+	right expr
+}
+
+func (*binaryExpr) isExpr() {}
+
+// callExpr is a builtin invocation such as len(x) or upper(s).
+type callExpr struct {
+	name string
+	arg  expr
+}
+
+func (*callExpr) isExpr() {}
diff --git a/minilang/env.go b/minilang/env.go
new file mode 100644
index 0000000..0aa9f68
--- /dev/null
+++ b/minilang/env.go
@@ -0,0 +1,24 @@
+package minilang
+
+// env holds the variable bindings for a running program.
+type env struct {
+	vars map[string]value
+}
+
+func newEnv() *env {
+	return &env{vars: make(map[string]value)}
+}
+
+// set binds name to v, overwriting any previous binding.
+func (e *env) set(name string, v value) {
+	e.vars[name] = v
+}
+
+// get returns the value bound to name, failing if it is undefined.
+func (e *env) get(name string) value {
+	v, ok := e.vars[name]
+	if !ok {
+		fail("undefined variable: " + name)
+	}
+	return v
+}
diff --git a/minilang/errors.go b/minilang/errors.go
new file mode 100644
index 0000000..1a6d49a
--- /dev/null
+++ b/minilang/errors.go
@@ -0,0 +1,15 @@
+package minilang
+
+// langError is a recoverable failure surfaced to the program as an
+// "error: <msg>" output line. It is raised via panic inside the lexer,
+// parser, and interpreter and recovered at the top level.
+type langError struct {
+	msg string
+}
+
+func (e *langError) Error() string { return e.msg }
+
+// fail raises a langError carrying the given message.
+func fail(msg string) {
+	panic(&langError{msg: msg})
+}
diff --git a/minilang/interp.go b/minilang/interp.go
new file mode 100644
index 0000000..947234a
--- /dev/null
+++ b/minilang/interp.go
@@ -0,0 +1,130 @@
+package minilang
+
+import (
+	"strings"
+)
+
+// Run executes a whole mini-language program and returns the joined output of
+// its print statements (newline-separated, no trailing newline). Any lex,
+// parse, or evaluation failure is reported as a single "error: <msg>" line.
+func Run(src string) (out string) {
+	defer func() {
+		if r := recover(); r != nil {
+			if le, ok := r.(*langError); ok {
+				out = "error: " + le.msg
+				return
+			}
+			panic(r)
+		}
+	}()
+	stmts := splitStatements(src)
+	e := newEnv()
+	var lines []string
+	for _, raw := range stmts {
+		s := parseStatementSource(raw)
+		switch n := s.(type) {
+		case *letStmt:
+			e.set(n.name, evalExpr(e, n.expr))
+		case *printStmt:
+			lines = append(lines, evalExpr(e, n.expr).display())
+		}
+	}
+	return strings.Join(lines, "\n")
+}
+
+// splitStatements breaks a program into statement sources on newlines and
+// semicolons, dropping blank statements.
+func splitStatements(src string) []string {
+	fields := strings.FieldsFunc(src, func(r rune) bool {
+		return r == '\n' || r == ';'
+	})
+	var out []string
+	for _, f := range fields {
+		if strings.TrimSpace(f) == "" {
+			continue
+		}
+		out = append(out, f)
+	}
+	return out
+}
+
+// evalExpr evaluates an expression node to a value.
+func evalExpr(e *env, node expr) value {
+	switch n := node.(type) {
+	case *intLit:
+		return intValue(n.value)
+	case *strLit:
+		return strValue(n.value)
+	case *varRef:
+		return e.get(n.name)
+	case *unaryExpr:
+		v := evalExpr(e, n.operand)
+		if n.op == tokMinus {
+			if !v.isInt() {
+				fail("type error: cannot negate a string")
+			}
+			return intValue(-v.i)
+		}
+		fail("bad operator")
+	case *binaryExpr:
+		return evalBinary(e, n)
+	case *callExpr:
+		return evalCall(e, n)
+	}
+	fail("bad expression")
+	return value{}
+}
+
+// evalBinary evaluates an infix operation. '+' is overloaded: int+int adds,
+// string+string concatenates, and any mix is a type error. The other operators
+// require two integers.
+func evalBinary(e *env, n *binaryExpr) value {
+	l := evalExpr(e, n.left)
+	r := evalExpr(e, n.right)
+	if n.op == tokPlus {
+		switch {
+		case l.isInt() && r.isInt():
+			return intValue(l.i + r.i)
+		case l.isStr() && r.isStr():
+			return strValue(l.s + r.s)
+		default:
+			fail("type error: cannot add an integer and a string")
+		}
+	}
+	if !l.isInt() || !r.isInt() {
+		fail("type error: arithmetic requires integers")
+	}
+	switch n.op {
+	case tokMinus:
+		return intValue(l.i - r.i)
+	case tokStar:
+		return intValue(l.i * r.i)
+	case tokSlash:
+		if r.i == 0 {
+			fail("division by zero")
+		}
+		return intValue(l.i / r.i)
+	}
+	fail("bad operator")
+	return value{}
+}
+
+// evalCall evaluates a builtin invocation. len(x) returns the length of a
+// string as an integer; upper(s) returns the upper-cased string.
+func evalCall(e *env, n *callExpr) value {
+	arg := evalExpr(e, n.arg)
+	switch n.name {
+	case "len":
+		if !arg.isStr() {
+			fail("type error: len expects a string")
+		}
+		return intValue(len(arg.s))
+	case "upper":
+		if !arg.isStr() {
+			fail("type error: upper expects a string")
+		}
+		return strValue(strings.ToUpper(arg.s))
+	}
+	fail("undefined function: " + n.name)
+	return value{}
+}
diff --git a/minilang/lexer.go b/minilang/lexer.go
new file mode 100644
index 0000000..f730fbb
--- /dev/null
+++ b/minilang/lexer.go
@@ -0,0 +1,153 @@
+package minilang
+
+const (
+	backslash byte = '\\'
+	newline   byte = '\n'
+)
+
+// lexer turns a single statement string into a stream of tokens. Whitespace
+// (other than the statement separators handled by the splitter) is ignored.
+type lexer struct {
+	src string
+	pos int
+}
+
+func newLexer(src string) *lexer {
+	return &lexer{src: src}
+}
+
+func isSpace(c byte) bool {
+	return c == ' ' || c == '\t' || c == '\r' || c == '\v' || c == '\f'
+}
+
+func isDigit(c byte) bool {
+	return c >= '0' && c <= '9'
+}
+
+func isIdentStart(c byte) bool {
+	return c == '_' || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
+}
+
+func isIdentPart(c byte) bool {
+	return isIdentStart(c) || isDigit(c)
+}
+
+// skipSpaces advances past any run of insignificant whitespace.
+func (l *lexer) skipSpaces() {
+	for l.pos < len(l.src) && isSpace(l.src[l.pos]) {
+		l.pos++
+	}
+}
+
+// next produces the next token from the source.
+func (l *lexer) next() token {
+	l.skipSpaces()
+	if l.pos >= len(l.src) {
+		return token{kind: tokEOF}
+	}
+	c := l.src[l.pos]
+	switch {
+	case isDigit(c):
+		return l.lexInt()
+	case isIdentStart(c):
+		return l.lexIdent()
+	case c == '"':
+		return l.lexString()
+	}
+	l.pos++
+	switch c {
+	case '+':
+		return token{kind: tokPlus}
+	case '-':
+		return token{kind: tokMinus}
+	case '*':
+		return token{kind: tokStar}
+	case '/':
+		return token{kind: tokSlash}
+	case '(':
+		return token{kind: tokLParen}
+	case ')':
+		return token{kind: tokRParen}
+	case ',':
+		return token{kind: tokComma}
+	case '=':
+		return token{kind: tokAssign}
+	}
+	fail("unexpected character")
+	return token{}
+}
+
+// lexInt reads a run of decimal digits.
+func (l *lexer) lexInt() token {
+	start := l.pos
+	for l.pos < len(l.src) && isDigit(l.src[l.pos]) {
+		l.pos++
+	}
+	return token{kind: tokInt, text: l.src[start:l.pos]}
+}
+
+// lexString reads a double-quoted string literal, honouring the escapes
+// for an escaped quote and a newline, and returns its decoded contents.
+func (l *lexer) lexString() token {
+	l.pos++ // consume opening quote
+	var b []byte
+	for l.pos < len(l.src) {
+		c := l.src[l.pos]
+		if c == '"' {
+			l.pos++
+			return token{kind: tokStr, text: string(b)}
+		}
+		if c == backslash {
+			l.pos++
+			if l.pos >= len(l.src) {
+				break
+			}
+			esc := l.src[l.pos]
+			switch esc {
+			case '"':
+				b = append(b, '"')
+			case 'n':
+				b = append(b, newline)
+			case backslash:
+				b = append(b, backslash)
+			default:
+				fail("bad string escape")
+			}
+			l.pos++
+			continue
+		}
+		b = append(b, c)
+		l.pos++
+	}
+	fail("unterminated string")
+	return token{}
+}
+
+// lexIdent reads an identifier or a reserved keyword (let, print).
+func (l *lexer) lexIdent() token {
+	start := l.pos
+	for l.pos < len(l.src) && isIdentPart(l.src[l.pos]) {
+		l.pos++
+	}
+	word := l.src[start:l.pos]
+	switch word {
+	case "let":
+		return token{kind: tokLet}
+	case "print":
+		return token{kind: tokPrint}
+	}
+	return token{kind: tokIdent, text: word}
+}
+
+// tokenize lexes the whole statement into a slice ending with tokEOF.
+func tokenize(src string) []token {
+	l := newLexer(src)
+	var toks []token
+	for {
+		t := l.next()
+		toks = append(toks, t)
+		if t.kind == tokEOF {
+			return toks
+		}
+	}
+}
diff --git a/minilang/parser.go b/minilang/parser.go
new file mode 100644
index 0000000..98bd913
--- /dev/null
+++ b/minilang/parser.go
@@ -0,0 +1,156 @@
+package minilang
+
+import "strconv"
+
+// parser is a recursive-descent parser over a token slice for one statement.
+type parser struct {
+	toks []token
+	pos  int
+}
+
+func newParser(toks []token) *parser {
+	return &parser{toks: toks}
+}
+
+func (p *parser) peek() token {
+	if p.pos >= len(p.toks) {
+		return token{kind: tokEOF}
+	}
+	return p.toks[p.pos]
+}
+
+func (p *parser) advance() token {
+	t := p.peek()
+	if p.pos < len(p.toks) {
+		p.pos++
+	}
+	return t
+}
+
+func (p *parser) expect(k tokenKind) token {
+	t := p.peek()
+	if t.kind != k {
+		fail("parse error")
+	}
+	return p.advance()
+}
+
+// parseStatement parses one complete statement and verifies the line ends.
+func (p *parser) parseStatement() stmt {
+	t := p.peek()
+	var s stmt
+	switch t.kind {
+	case tokLet:
+		s = p.parseLet()
+	case tokPrint:
+		s = p.parsePrint()
+	default:
+		fail("parse error")
+	}
+	if p.peek().kind != tokEOF {
+		fail("parse error")
+	}
+	return s
+}
+
+// parseLet parses: let <ident> = <expr>
+func (p *parser) parseLet() stmt {
+	p.expect(tokLet)
+	name := p.expect(tokIdent).text
+	p.expect(tokAssign)
+	e := p.parseExpr()
+	return &letStmt{name: name, expr: e}
+}
+
+// parsePrint parses: print <expr>
+func (p *parser) parsePrint() stmt {
+	p.expect(tokPrint)
+	e := p.parseExpr()
+	return &printStmt{expr: e}
+}
+
+// parseExpr handles the lowest precedence: '+' and '-', left-associative.
+func (p *parser) parseExpr() expr {
+	left := p.parseTerm()
+	for {
+		k := p.peek().kind
+		if k == tokPlus || k == tokMinus {
+			p.advance()
+			right := p.parseTerm()
+			left = &binaryExpr{op: k, left: left, right: right}
+			continue
+		}
+		break
+	}
+	return left
+}
+
+// parseTerm handles '*' and '/', which bind tighter, left-associative.
+func (p *parser) parseTerm() expr {
+	left := p.parseUnary()
+	for {
+		k := p.peek().kind
+		if k == tokStar || k == tokSlash {
+			p.advance()
+			right := p.parseUnary()
+			left = &binaryExpr{op: k, left: left, right: right}
+			continue
+		}
+		break
+	}
+	return left
+}
+
+// parseUnary handles a leading minus in any position.
+func (p *parser) parseUnary() expr {
+	if p.peek().kind == tokMinus {
+		p.advance()
+		return &unaryExpr{op: tokMinus, operand: p.parseUnary()}
+	}
+	return p.parsePrimary()
+}
+
+// parsePrimary handles literals, variables, builtin calls, and parenthesised
+// groups.
+func (p *parser) parsePrimary() expr {
+	t := p.peek()
+	switch t.kind {
+	case tokInt:
+		p.advance()
+		n, err := strconv.Atoi(t.text)
+		if err != nil {
+			fail("parse error")
+		}
+		return &intLit{value: n}
+	case tokStr:
+		p.advance()
+		return &strLit{value: t.text}
+	case tokIdent:
+		p.advance()
+		// An identifier directly followed by '(' is a builtin call.
+		if p.peek().kind == tokLParen {
+			return p.parseCall(t.text)
+		}
+		return &varRef{name: t.text}
+	case tokLParen:
+		p.advance()
+		e := p.parseExpr()
+		p.expect(tokRParen)
+		return e
+	}
+	fail("parse error")
+	return nil
+}
+
+// parseCall parses a single-argument builtin call: name '(' expr ')'.
+func (p *parser) parseCall(name string) expr {
+	p.expect(tokLParen)
+	arg := p.parseExpr()
+	p.expect(tokRParen)
+	return &callExpr{name: name, arg: arg}
+}
+
+// parseStatementSource lexes and parses one statement string.
+func parseStatementSource(src string) stmt {
+	return newParser(tokenize(src)).parseStatement()
+}
diff --git a/minilang/token.go b/minilang/token.go
new file mode 100644
index 0000000..03c283c
--- /dev/null
+++ b/minilang/token.go
@@ -0,0 +1,29 @@
+package minilang
+
+// tokenKind enumerates the lexical categories the lexer can produce.
+type tokenKind int
+
+const (
+	tokEOF tokenKind = iota
+	tokInt
+	tokStr
+	tokIdent
+	tokPlus
+	tokMinus
+	tokStar
+	tokSlash
+	tokLParen
+	tokRParen
+	tokComma
+	tokAssign
+	tokLet
+	tokPrint
+)
+
+// token is a single lexical unit with its source text payload.
+type token struct {
+	kind tokenKind
+	// text holds the literal characters for integers and identifiers, and the
+	// already-unescaped contents for string literals.
+	text string
+}
diff --git a/minilang/value.go b/minilang/value.go
new file mode 100644
index 0000000..d60f2f9
--- /dev/null
+++ b/minilang/value.go
@@ -0,0 +1,39 @@
+package minilang
+
+import "strconv"
+
+// valueKind tags the dynamic type of a runtime value.
+type valueKind int
+
+const (
+	kindInt valueKind = iota
+	kindStr
+)
+
+// value is a runtime value produced by evaluating an expression. It is either
+// an integer or a string, distinguished by kind.
+type value struct {
+	kind valueKind
+	i    int
+	s    string
+}
+
+func intValue(i int) value {
+	return value{kind: kindInt, i: i}
+}
+
+func strValue(s string) value {
+	return value{kind: kindStr, s: s}
+}
+
+func (v value) isInt() bool { return v.kind == kindInt }
+func (v value) isStr() bool { return v.kind == kindStr }
+
+// display renders a value the way print emits it: integers as digits and
+// strings as their raw contents.
+func (v value) display() string {
+	if v.kind == kindStr {
+		return v.s
+	}
+	return strconv.Itoa(v.i)
+}
diff --git a/stdlib/core/tbx.go b/stdlib/core/tbx.go
new file mode 100644
index 0000000..fcd78e8
--- /dev/null
+++ b/stdlib/core/tbx.go
@@ -0,0 +1,19 @@
+package core
+
+import (
+	"reflect"
+
+	"github.com/mvm-sh/mvm/minilang"
+	"github.com/mvm-sh/mvm/stdlib"
+)
+
+// tbxRun executes a mini-language program and returns its printed output.
+func tbxRun(src string) string {
+	return minilang.Run(src)
+}
+
+func init() {
+	stdlib.Values["tbx"] = map[string]reflect.Value{
+		"Run": reflect.ValueOf(tbxRun),
+	}
+}
