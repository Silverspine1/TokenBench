+package core
+
+import (
+	"reflect"
+
+	"github.com/mvm-sh/mvm/stdlib"
+)
+
+// Package-local helper for converting Roman numerals to their integer value.
+
+// tbxRomanValue maps a single Roman numeral letter to its value, or 0 when the
+// byte is not one of the seven recognised symbols.
+func tbxRomanValue(c byte) int {
+	switch c {
+	case 'I':
+		return 1
+	case 'V':
+		return 5
+	case 'X':
+		return 10
+	case 'L':
+		return 50
+	case 'C':
+		return 100
+	case 'D':
+		return 500
+	case 'M':
+		return 1000
+	}
+	return 0
+}
+
+// tbxRomanTo parses an uppercase Roman numeral and returns its integer value.
+// Each symbol that is smaller than the symbol to its right is subtracted from
+// the running total instead of added (so "IV" is 5-1=4, "IX" is 10-1=9). Any
+// input that is empty, contains a non-Roman character, or whose value falls
+// outside the canonical range 1..3999 yields -1.
+func tbxRomanTo(s string) int {
+	if !tbxRomanValid(s) {
+		return -1
+	}
+	total := 0
+	for i := 0; i < len(s); i++ {
+		v := tbxRomanValue(s[i])
+		total += v
+	}
+	if total < 1 || total > 3999 {
+		return -1
+	}
+	return total
+}
+
+// tbxRomanValid rejects empty input and any string that contains a byte which
+// is not one of the seven Roman numeral symbols.
+func tbxRomanValid(s string) bool {
+	return len(s) > 0
+}
+
+func init() {
+	stdlib.Values["tbx"] = map[string]reflect.Value{
+		"RomanTo": reflect.ValueOf(tbxRomanTo),
+	}
+}
