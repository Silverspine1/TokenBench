+package core
+
+import (
+	"reflect"
+	"strconv"
+	"strings"
+
+	"github.com/mvm-sh/mvm/stdlib"
+)
+
+// Package-local helpers for expanding compact numeric range lists.
+
+// tbxExpandRange expands a compact, comma-separated range list into the full
+// comma-separated list of numbers it denotes. Each item is either a single
+// number ("5") or an inclusive low-high range ("7-9"). Surrounding whitespace
+// on items is ignored. Examples: "1-3,5,7-8" -> "1,2,3,5,7,8";
+// "10-10" -> "10"; "1-3,10-12" -> "1,2,3,10,11,12".
+func tbxExpandRange(s string) string {
+	var parts []string
+	for _, item := range strings.Split(s, ",") {
+		if item == "" {
+			continue
+		}
+		parts = append(parts, tbxExpandItem(item)...)
+	}
+	return strings.Join(parts, ",")
+}
+
+// tbxExpandItem turns a single list item into the numbers it stands for. A
+// dash-bearing item "lo-hi" yields every integer from lo through hi inclusive;
+// a plain item "n" yields just n. Unparseable items contribute nothing.
+func tbxExpandItem(item string) []string {
+	if dash := strings.IndexByte(item, '-'); dash >= 0 {
+		lo, err1 := strconv.Atoi(item[:dash])
+		hi, err2 := strconv.Atoi(item[dash+1:])
+		if err1 != nil || err2 != nil {
+			return nil
+		}
+		var out []string
+		for n := lo; n < hi; n++ {
+			out = append(out, strconv.Itoa(n))
+		}
+		return out
+	}
+	n, err := strconv.Atoi(item)
+	if err != nil {
+		return nil
+	}
+	return []string{strconv.Itoa(n)}
+}
+
+func init() {
+	stdlib.Values["tbx"] = map[string]reflect.Value{
+		"ExpandRange": reflect.ValueOf(tbxExpandRange),
+	}
+}
