+
+    private static readonly string[] _byteUnits = { "B", "KB", "MB", "GB" };
+
+    /// <summary>
+    /// Formats a byte count into a compact human-readable string using 1024-based
+    /// units (B, KB, MB, GB). The transformation is an ordered pipeline: choose the
+    /// largest unit whose 1024-power does not exceed the value, scale the value into
+    /// that unit, then render the scaled value with the unit label.
+    /// </summary>
+    private static string FormatBytes(double n)
+    {
+        int unit = ByteUnitIndex(n);
+        double scaled = ScaleToUnit(n, unit);
+        return RenderBytes(scaled, unit);
+    }
+
+    /// <summary>
+    /// Returns the index into <see cref="_byteUnits"/> of the largest unit whose
+    /// 1024-power is less than or equal to the value, clamped to the largest known
+    /// unit (GB). A value below 1024 stays in bytes (index 0).
+    /// </summary>
+    private static int ByteUnitIndex(double n)
+    {
+        int unit = 0;
+        double threshold = 1024.0;
+        while (unit < _byteUnits.Length - 1 && n > threshold)
+        {
+            unit++;
+            threshold *= 1024.0;
+        }
+        return unit;
+    }
+
+    /// <summary>
+    /// Divides the value by 1024 raised to the chosen unit index, yielding the value
+    /// expressed in that unit.
+    /// </summary>
+    private static double ScaleToUnit(double n, int unit)
+    {
+        double divisor = 1.0;
+        for (int i = 0; i < unit; i++)
+        {
+            divisor *= 1024.0;
+        }
+        return n / divisor;
+    }
+
+    /// <summary>
+    /// Renders a value already scaled into the given unit. Bytes are rendered as a
+    /// whole number with no decimal places. Larger units are rounded to a single
+    /// decimal place, and a trailing ".0" is dropped so whole values read cleanly
+    /// (e.g. "1 KB" rather than "1.0 KB").
+    /// </summary>
+    private static string RenderBytes(double scaled, int unit)
+    {
+        string label = _byteUnits[unit];
+        if (unit == 0)
+        {
+            long whole = (long)scaled;
+            return whole.ToString(CultureInfo.InvariantCulture) + " " + label;
+        }
+
+        double rounded = Math.Round(scaled, 1, MidpointRounding.AwayFromZero);
+        string text = rounded.ToString("0.0", CultureInfo.InvariantCulture);
+        return text + " " + label;
+    }
 }
