@@ -0,0 +1,13 @@
+namespace SharpTS.Runtime.MiniLang;
+
+/// <summary>
+/// Raised when a mini-language program cannot be lexed, parsed, or evaluated.
+/// The message is surfaced to the caller as the program's sole output line,
+/// formatted as "error: &lt;message&gt;".
+/// </summary>
+public sealed class MlError : System.Exception
+{
+    public MlError(string message) : base(message)
+    {
+    }
+}
diff --git a/Runtime/MiniLang/MlValue.cs b/Runtime/MiniLang/MlValue.cs
new file mode 100644
index 00000000..c25af861
--- /dev/null
+++ b/Runtime/MiniLang/MlValue.cs
@@ -0,0 +1,44 @@
+using System.Globalization;
+
+namespace SharpTS.Runtime.MiniLang;
+
+/// <summary>
+/// A runtime value in the mini-language. Stage 1 supports numbers only; the
+/// value carries a discriminator so additional kinds can be layered on later.
+/// </summary>
+public readonly struct MlValue
+{
+    public enum Kind
+    {
+        Number,
+    }
+
+    public Kind ValueKind { get; }
+    public double Number { get; }
+
+    private MlValue(Kind kind, double number)
+    {
+        ValueKind = kind;
+        Number = number;
+    }
+
+    public static MlValue FromNumber(double n) => new(Kind.Number, n);
+
+    /// <summary>
+    /// Formats the value the way JavaScript would when printed: integer-valued
+    /// numbers carry no decimal point, the rest use the round-trip shortest form.
+    /// </summary>
+    public string Display()
+    {
+        return FormatNumber(Number);
+    }
+
+    public static string FormatNumber(double n)
+    {
+        if (double.IsNaN(n)) return "NaN";
+        if (double.IsPositiveInfinity(n)) return "Infinity";
+        if (double.IsNegativeInfinity(n)) return "-Infinity";
+        if (n == 0) return "0"; // collapse -0 to 0
+        return n.ToString("R", CultureInfo.InvariantCulture);
+    }
+}
diff --git a/Runtime/MiniLang/Parser.cs b/Runtime/MiniLang/Parser.cs
new file mode 100644
index 00000000..7121f824
--- /dev/null
+++ b/Runtime/MiniLang/Parser.cs
@@ -0,0 +1,156 @@
+using System.Collections.Generic;
+using System.Globalization;
+
+namespace SharpTS.Runtime.MiniLang;
+
+/// <summary>
+/// Recursive-descent parser for the mini-language. Produces a <see cref="Program"/>
+/// from a token list. Grammar (standard precedence, left-associative):
+///   program := (statement (SEP statement)*)?
+///   statement := 'let' IDENT '=' expr | 'print' expr
+///   expr   := term (('+' | '-') term)*
+///   term   := factor (('*' | '/') factor)*
+///   factor := '-' factor | primary
+///   primary:= NUMBER | IDENT | '(' expr ')'
+/// </summary>
+public sealed class Parser
+{
+    private readonly List<Token> _tokens;
+    private int _pos;
+
+    public Parser(List<Token> tokens)
+    {
+        _tokens = tokens;
+    }
+
+    private Token Current => _tokens[_pos];
+
+    private Token Advance() => _tokens[_pos++];
+
+    private bool Check(TokenType type) => Current.Type == type;
+
+    private bool Match(TokenType type)
+    {
+        if (Check(type))
+        {
+            _pos++;
+            return true;
+        }
+        return false;
+    }
+
+    private void Expect(TokenType type, string what)
+    {
+        if (!Match(type))
+        {
+            throw new MlError($"expected {what}");
+        }
+    }
+
+    private void SkipSeparators()
+    {
+        while (Check(TokenType.Semicolon))
+        {
+            _pos++;
+        }
+    }
+
+    public Program ParseProgram()
+    {
+        var statements = new List<Stmt>();
+        SkipSeparators();
+        while (!Check(TokenType.Eof))
+        {
+            statements.Add(ParseStatement());
+            if (!Check(TokenType.Eof))
+            {
+                if (!Check(TokenType.Semicolon))
+                {
+                    throw new MlError("expected end of statement");
+                }
+                SkipSeparators();
+            }
+        }
+        return new Program(statements);
+    }
+
+    private Stmt ParseStatement()
+    {
+        if (Match(TokenType.Let))
+        {
+            if (!Check(TokenType.Identifier))
+            {
+                throw new MlError("expected variable name after 'let'");
+            }
+            string name = Advance().Text;
+            Expect(TokenType.Assign, "'=' in let binding");
+            Expr value = ParseExpr();
+            return new LetStmt(name, value);
+        }
+
+        if (Match(TokenType.Print))
+        {
+            Expr value = ParseExpr();
+            return new PrintStmt(value);
+        }
+
+        throw new MlError("expected 'let' or 'print'");
+    }
+
+    private Expr ParseExpr()
+    {
+        Expr left = ParseTerm();
+        while (Check(TokenType.Plus) || Check(TokenType.Minus))
+        {
+            TokenType op = Advance().Type;
+            Expr right = ParseTerm();
+            left = new Binary(op, left, right);
+        }
+        return left;
+    }
+
+    private Expr ParseTerm()
+    {
+        Expr left = ParseFactor();
+        while (Check(TokenType.Star) || Check(TokenType.Slash))
+        {
+            TokenType op = Advance().Type;
+            Expr right = ParseFactor();
+            left = new Binary(op, left, right);
+        }
+        return left;
+    }
+
+    private Expr ParseFactor()
+    {
+        if (Match(TokenType.Minus))
+        {
+            return new Unary(ParseFactor());
+        }
+        return ParsePrimary();
+    }
+
+    private Expr ParsePrimary()
+    {
+        if (Check(TokenType.Number))
+        {
+            string text = Advance().Text;
+            double value = double.Parse(text, NumberStyles.Float, CultureInfo.InvariantCulture);
+            return new NumberLiteral(value);
+        }
+
+        if (Check(TokenType.Identifier))
+        {
+            return new VariableRef(Advance().Text);
+        }
+
+        if (Match(TokenType.LParen))
+        {
+            Expr inner = ParseExpr();
+            Expect(TokenType.RParen, "closing ')'");
+            return inner;
+        }
+
+        throw new MlError("unexpected token in expression");
+    }
+}
