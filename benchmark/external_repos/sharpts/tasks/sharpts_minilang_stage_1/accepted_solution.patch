+++ b/Runtime/MiniLang/Token.cs
@@ -0,0 +1,39 @@
+namespace SharpTS.Runtime.MiniLang;
+
+/// <summary>The lexical categories produced by the mini-language lexer.</summary>
+public enum TokenType
+{
+    Number,
+    Identifier,
+    Let,
+    Print,
+    Assign,     // =
+    Plus,       // +
+    Minus,      // -
+    Star,       // *
+    Slash,      // /
+    LParen,     // (
+    RParen,     // )
+    Semicolon,  // ; or newline statement separator
+    Eof,
+}
+
+/// <summary>A single lexical token with its literal text payload.</summary>
+public readonly struct Token
+{
+    public TokenType Type { get; }
+
+    /// <summary>
+    /// The raw text of the token. For numbers this is the literal digits;
+    /// for identifiers the name.
+    /// </summary>
+    public string Text { get; }
+
+    public Token(TokenType type, string text)
+    {
+        Type = type;
+        Text = text;
+    }
+
+    public override string ToString() => $"{Type}:{Text}";
+}
