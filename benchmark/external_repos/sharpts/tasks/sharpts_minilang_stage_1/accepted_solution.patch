@@ -0,0 +1,26 @@
+using System.Collections.Generic;
+
+namespace SharpTS.Runtime.MiniLang;
+
+/// <summary>
+/// Maps variable names to their bound <see cref="MlValue"/>. A single flat
+/// scope is sufficient for the mini-language (no nested scopes or functions).
+/// </summary>
+public sealed class Environment
+{
+    private readonly Dictionary<string, MlValue> _values = new();
+
+    public void Define(string name, MlValue value)
+    {
+        _values[name] = value;
+    }
+
+    public MlValue Get(string name)
+    {
+        if (_values.TryGetValue(name, out MlValue value))
+        {
+            return value;
+        }
+        throw new MlError($"undefined variable '{name}'");
+    }
+}
diff --git a/Runtime/MiniLang/Interpreter.cs b/Runtime/MiniLang/Interpreter.cs
new file mode 100644
index 00000000..fa6b1d4e
--- /dev/null
+++ b/Runtime/MiniLang/Interpreter.cs
@@ -0,0 +1,87 @@
+using System.Collections.Generic;
+using System.Text;
+
+namespace SharpTS.Runtime.MiniLang;
+
+/// <summary>
+/// The public entry point of the mini-language subsystem. Lexes, parses, and
+/// evaluates a source program, returning the joined output lines.
+/// </summary>
+public static class Interpreter
+{
+    /// <summary>
+    /// Runs <paramref name="source"/> and returns the program output: each
+    /// <c>print</c> statement contributes one line, joined with '\n' and no
+    /// trailing newline. Any lex/parse/eval error collapses the whole output to
+    /// the single line "error: &lt;message&gt;".
+    /// </summary>
+    public static string Run(string source)
+    {
+        try
+        {
+            var tokens = new Lexer(source).Tokenize();
+            Program program = new Parser(tokens).ParseProgram();
+            return Execute(program);
+        }
+        catch (MlError ex)
+        {
+            return "error: " + ex.Message;
+        }
+    }
+
+    private static string Execute(Program program)
+    {
+        var env = new Environment();
+        var output = new List<string>();
+
+        foreach (Stmt stmt in program.Statements)
+        {
+            switch (stmt)
+            {
+                case LetStmt let:
+                    env.Define(let.Name, Evaluate(let.Value, env));
+                    break;
+                case PrintStmt print:
+                    output.Add(Evaluate(print.Value, env).Display());
+                    break;
+            }
+        }
+
+        return string.Join("\n", output);
+    }
+
+    private static MlValue Evaluate(Expr expr, Environment env)
+    {
+        switch (expr)
+        {
+            case NumberLiteral n:
+                return MlValue.FromNumber(n.Value);
+            case VariableRef v:
+                return env.Get(v.Name);
+            case Unary u:
+                return MlValue.FromNumber(-Evaluate(u.Operand, env).Number);
+            case Binary b:
+                return EvaluateBinary(b, env);
+            default:
+                throw new MlError("unknown expression");
+        }
+    }
+
+    private static MlValue EvaluateBinary(Binary b, Environment env)
+    {
+        MlValue left = Evaluate(b.Left, env);
+        MlValue right = Evaluate(b.Right, env);
+
+        double l = left.Number;
+        double r = right.Number;
+        double result = b.Op switch
+        {
+            TokenType.Plus => l + r,
+            TokenType.Minus => l - r,
+            TokenType.Star => l * r,
+            TokenType.Slash => l / r,
+            _ => throw new MlError("unknown operator"),
+        };
+        return MlValue.FromNumber(result);
+    }
+}
diff --git a/Runtime/MiniLang/Lexer.cs b/Runtime/MiniLang/Lexer.cs
new file mode 100644
index 00000000..12f512a2
--- /dev/null
+++ b/Runtime/MiniLang/Lexer.cs
@@ -0,0 +1,154 @@
+using System.Collections.Generic;
+using System.Globalization;
+using System.Text;
+
+namespace SharpTS.Runtime.MiniLang;
+
+/// <summary>
+/// Converts mini-language source text into a flat list of tokens.
+/// Whitespace (other than newlines, which act as statement separators) is
+/// discarded. Keywords <c>let</c> and <c>print</c> are recognised here.
+/// </summary>
+public sealed class Lexer
+{
+    private readonly string _src;
+    private int _pos;
+
+    public Lexer(string source)
+    {
+        _src = source ?? string.Empty;
+    }
+
+    public List<Token> Tokenize()
+    {
+        var tokens = new List<Token>();
+        while (_pos < _src.Length)
+        {
+            char c = _src[_pos];
+
+            if (c == '\n' || c == ';')
+            {
+                tokens.Add(new Token(TokenType.Semicolon, c == '\n' ? "\\n" : ";"));
+                _pos++;
+                continue;
+            }
+
+            if (c == ' ' || c == '\t' || c == '\r')
+            {
+                _pos++;
+                continue;
+            }
+
+            switch (c)
+            {
+                case '=':
+                    tokens.Add(new Token(TokenType.Assign, "="));
+                    _pos++;
+                    continue;
+                case '+':
+                    tokens.Add(new Token(TokenType.Plus, "+"));
+                    _pos++;
+                    continue;
+                case '-':
+                    tokens.Add(new Token(TokenType.Minus, "-"));
+                    _pos++;
+                    continue;
+                case '*':
+                    tokens.Add(new Token(TokenType.Star, "*"));
+                    _pos++;
+                    continue;
+                case '/':
+                    tokens.Add(new Token(TokenType.Slash, "/"));
+                    _pos++;
+                    continue;
+                case '(':
+                    tokens.Add(new Token(TokenType.LParen, "("));
+                    _pos++;
+                    continue;
+                case ')':
+                    tokens.Add(new Token(TokenType.RParen, ")"));
+                    _pos++;
+                    continue;
+            }
+
+            if (char.IsDigit(c) || c == '.')
+            {
+                tokens.Add(ReadNumber());
+                continue;
+            }
+
+            if (char.IsLetter(c) || c == '_')
+            {
+                tokens.Add(ReadWord());
+                continue;
+            }
+
+            throw new MlError($"unexpected character '{c}'");
+        }
+
+        tokens.Add(new Token(TokenType.Eof, ""));
+        return tokens;
+    }
+
+    private Token ReadNumber()
+    {
+        int start = _pos;
+        bool seenDot = false;
+        while (_pos < _src.Length)
+        {
+            char c = _src[_pos];
+            if (char.IsDigit(c))
+            {
+                _pos++;
+            }
+            else if (c == '.' && !seenDot)
+            {
+                seenDot = true;
+                _pos++;
+            }
+            else
+            {
+                break;
+            }
+        }
+
+        string literal = _src.Substring(start, _pos - start);
+        if (literal == "." || literal.Length == 0)
+        {
+            throw new MlError("invalid number");
+        }
+
+        // Validate now so a parse-time error surfaces uniformly.
+        if (!double.TryParse(literal, NumberStyles.Float, CultureInfo.InvariantCulture, out _))
+        {
+            throw new MlError($"invalid number '{literal}'");
+        }
+
+        return new Token(TokenType.Number, literal);
+    }
+
+    private Token ReadWord()
+    {
+        int start = _pos;
+        while (_pos < _src.Length)
+        {
+            char c = _src[_pos];
+            if (char.IsLetterOrDigit(c) || c == '_')
+            {
+                _pos++;
+            }
+            else
+            {
+                break;
+            }
+        }
+
+        string word = _src.Substring(start, _pos - start);
+        return word switch
+        {
+            "let" => new Token(TokenType.Let, word),
+            "print" => new Token(TokenType.Print, word),
+            _ => new Token(TokenType.Identifier, word),
+        };
+    }
+}
