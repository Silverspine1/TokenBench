+
+    /// <summary>
+    /// Formats a total number of seconds as a human-readable duration string.
+    /// The transformation is an ordered pipeline: split the total into whole
+    /// hours/minutes/seconds, build the visible unit segments (dropping leading
+    /// zero units and zero-padding trailing units), then join with single spaces.
+    /// </summary>
+    private static string Duration(double totalSeconds)
+    {
+        if (totalSeconds < 0) return "";
+        int[] units = DBreak(totalSeconds);
+        string[] parts = DParts(units);
+        return DJoin(parts);
+    }
+
+    /// <summary>
+    /// Splits a non-negative second count into whole hours, minutes and seconds.
+    /// Fractional seconds are discarded by flooring the input first.
+    /// </summary>
+    private static int[] DBreak(double totalSeconds)
+    {
+        long whole = (long)Math.Floor(totalSeconds);
+        int hours = (int)(whole / 3600);
+        int minutes = (int)((whole % 3600) / 60);
+        int seconds = (int)(whole % 60);
+        return new[] { hours, minutes, seconds };
+    }
+
+    /// <summary>
+    /// Builds the visible unit segments from the [hours, minutes, seconds] triple.
+    /// Leading zero-valued units are omitted; once a non-zero unit has appeared,
+    /// every lower unit is shown even when it is zero. Minutes and seconds are
+    /// zero-padded to two digits whenever they are not the first shown unit; the
+    /// first shown unit (and hours) are never padded. An all-zero input yields a
+    /// single "0s" segment.
+    /// </summary>
+    private static string[] DParts(int[] units)
+    {
+        string[] suffix = { "h", "m", "s" };
+        var parts = new List<string>();
+        for (int i = 0; i < units.Length; i++)
+        {
+            int value = units[i];
+            if (value == 0 && i < units.Length - 1)
+            {
+                continue;
+            }
+            bool firstShown = i == 0;
+            string number = (firstShown || i == 0) ? value.ToString() : DPad(value);
+            parts.Add(number + suffix[i]);
+        }
+        return parts.ToArray();
+    }
+
+    /// <summary>Formats a unit value zero-padded to at least two digits.</summary>
+    private static string DPad(int value)
+    {
+        string text = value.ToString();
+        if (text.Length < 2)
+        {
+            text = "0" + text;
+        }
+        return text;
+    }
+
+    /// <summary>Joins the visible unit segments with single spaces.</summary>
+    private static string DJoin(string[] parts)
+    {
+        var sb = new StringBuilder();
+        for (int i = 0; i < parts.Length; i++)
+        {
+            if (i > 0) sb.Append(' ');
+            sb.Append(parts[i]);
+        }
+        return sb.ToString();
+    }
 }
