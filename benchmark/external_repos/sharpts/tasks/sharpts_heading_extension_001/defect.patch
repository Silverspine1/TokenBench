+    private static readonly HashSet<string> _headingSmallWords = new()
+    {
+        "a", "an", "the", "of", "and", "or", "in", "on", "to", "for"
+    };
+
+    /// <summary>
+    /// Formats an arbitrary string as a display heading. The transformation is an
+    /// ordered pipeline: normalize the spacing and split into words, title-case the
+    /// words (with small-word and acronym handling), then strip trailing punctuation.
+    /// </summary>
+    private static string Heading(string input)
+    {
+        string[] words = HNormalize(input);
+        string joined = HTitleCase(words);
+        return HFinish(joined);
+    }
+
+    /// <summary>
+    /// Trims the input, collapses internal whitespace runs to a single space, and
+    /// splits the result into words on spaces.
+    /// </summary>
+    private static string[] HNormalize(string input)
+    {
+        var words = new List<string>();
+        var sb = new StringBuilder();
+        foreach (char c in input)
+        {
+            if (c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\f' || c == '\v')
+            {
+                if (sb.Length > 0)
+                {
+                    words.Add(sb.ToString());
+                    sb.Clear();
+                }
+            }
+            else
+            {
+                sb.Append(c);
+            }
+        }
+        if (sb.Length > 0) words.Add(sb.ToString());
+        return words.ToArray();
+    }
+
+    /// <summary>
+    /// Title-cases each word. Short connective words ("a", "the", "of", ...) are
+    /// fully lowercased except when they are the first or last word of the heading,
+    /// which are always title-cased. A word that is all-uppercase in the input and
+    /// at most four characters long (e.g. "API", "HTML") is preserved verbatim.
+    /// </summary>
+    private static string HTitleCase(string[] words)
+    {
+        var result = new string[words.Length];
+        int last = words.Length - 1;
+        for (int i = 0; i < words.Length; i++)
+        {
+            string word = words[i];
+            if (IsAcronym(word))
+            {
+                result[i] = word;
+                continue;
+            }
+
+            string lower = word.ToLowerInvariant();
+            bool edge = i == 0;
+            if (!edge && _headingSmallWords.Contains(lower))
+            {
+                result[i] = lower;
+            }
+            else
+            {
+                result[i] = TitleCaseWord(lower);
+            }
+        }
+        return string.Join(" ", result);
+    }
+
+    /// <summary>
+    /// True when the word is all uppercase letters in the input and is no longer
+    /// than four characters, marking it as an acronym to be preserved verbatim.
+    /// </summary>
+    private static bool IsAcronym(string word)
+    {
+        if (word.Length == 0 || word.Length >= 4) return false;
+        foreach (char c in word)
+        {
+            if (c < 'A' || c > 'Z') return false;
+        }
+        return true;
+    }
+
+    private static string TitleCaseWord(string lower)
+    {
+        if (lower.Length == 0) return lower;
+        var sb = new StringBuilder(lower.Length);
+        sb.Append(char.ToUpperInvariant(lower[0]));
+        sb.Append(lower, 1, lower.Length - 1);
+        return sb.ToString();
+    }
+
+    /// <summary>
+    /// Strips any run of trailing punctuation characters (one or more of
+    /// '.', ',', ';', ':', '!') from the end of the heading.
+    /// </summary>
+    private static string HFinish(string input)
+    {
+        int end = input.Length;
+        if (end > 0 && IsTrailingPunct(input[end - 1]))
+        {
+            end--;
+        }
+        return input.Substring(0, end);
+    }
+
+    private static bool IsTrailingPunct(char c)
+        => c == '.' || c == ',' || c == ';' || c == ':' || c == '!';
