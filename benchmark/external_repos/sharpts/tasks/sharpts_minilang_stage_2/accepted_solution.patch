diff --git a/Runtime/MiniLang/Ast.cs b/Runtime/MiniLang/Ast.cs
new file mode 100644
index 00000000..5998543a
--- /dev/null
+++ b/Runtime/MiniLang/Ast.cs
@@ -0,0 +1,93 @@
+using System.Collections.Generic;
+
+namespace SharpTS.Runtime.MiniLang;
+
+/// <summary>Base type for every mini-language expression node.</summary>
+public abstract class Expr
+{
+}
+
+/// <summary>A numeric literal, e.g. <c>42</c> or <c>1.5</c>.</summary>
+public sealed class NumberLiteral : Expr
+{
+    public double Value { get; }
+    public NumberLiteral(double value) => Value = value;
+}
+
+/// <summary>A string literal with its already-unescaped content.</summary>
+public sealed class StringLiteral : Expr
+{
+    public string Value { get; }
+    public StringLiteral(string value) => Value = value;
+}
+
+/// <summary>A reference to a previously bound variable.</summary>
+public sealed class VariableRef : Expr
+{
+    public string Name { get; }
+    public VariableRef(string name) => Name = name;
+}
+
+/// <summary>A built-in call such as <c>len(x)</c> or <c>upper(x)</c>.</summary>
+public sealed class Call : Expr
+{
+    public string Callee { get; }
+    public List<Expr> Arguments { get; }
+    public Call(string callee, List<Expr> arguments)
+    {
+        Callee = callee;
+        Arguments = arguments;
+    }
+}
+
+/// <summary>Unary negation of the operand expression.</summary>
+public sealed class Unary : Expr
+{
+    public Expr Operand { get; }
+    public Unary(Expr operand) => Operand = operand;
+}
+
+/// <summary>A binary arithmetic operation: one of <c>+ - * /</c>.</summary>
+public sealed class Binary : Expr
+{
+    public TokenType Op { get; }
+    public Expr Left { get; }
+    public Expr Right { get; }
+    public Binary(TokenType op, Expr left, Expr right)
+    {
+        Op = op;
+        Left = left;
+        Right = right;
+    }
+}
+
+/// <summary>Base type for every mini-language statement node.</summary>
+public abstract class Stmt
+{
+}
+
+/// <summary><c>let &lt;name&gt; = &lt;expr&gt;</c> — binds a variable.</summary>
+public sealed class LetStmt : Stmt
+{
+    public string Name { get; }
+    public Expr Value { get; }
+    public LetStmt(string name, Expr value)
+    {
+        Name = name;
+        Value = value;
+    }
+}
+
+/// <summary><c>print &lt;expr&gt;</c> — appends one output line.</summary>
+public sealed class PrintStmt : Stmt
+{
+    public Expr Value { get; }
+    public PrintStmt(Expr value) => Value = value;
+}
+
+/// <summary>A whole program: an ordered list of statements.</summary>
+public sealed class Program
+{
+    public List<Stmt> Statements { get; }
+    public Program(List<Stmt> statements) => Statements = statements;
+}
