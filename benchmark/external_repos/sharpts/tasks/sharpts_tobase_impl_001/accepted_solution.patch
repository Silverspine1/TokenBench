+
+    /// <summary>
+    /// Converts an integer to its string representation in the given base (2..16).
+    /// Digits 0-9 then lowercase a-f are used for values 10-15. A negative value
+    /// produces a leading '-' followed by the magnitude; zero produces "0".
+    /// </summary>
+    private static string ToBase(double n, double baseValue)
+    {
+        long value = (long)Math.Truncate(n);
+        int radix = (int)Math.Truncate(baseValue);
+
+        if (radix < 2 || radix > 16)
+        {
+            throw new InvalidOperationException(
+                $"Runtime Error: Math.toBase base must be between 2 and 16, got {radix}");
+        }
+
+        if (value == 0)
+        {
+            return "0";
+        }
+
+        const string digits = "0123456789abcdef";
+        bool negative = value < 0;
+
+        // Accumulate the unsigned magnitude. Use ulong so the most negative
+        // long value (which has no positive long counterpart) is handled too.
+        ulong magnitude = negative ? (ulong)(-(value + 1)) + 1UL : (ulong)value;
+
+        var sb = new System.Text.StringBuilder();
+        while (magnitude > 0)
+        {
+            int d = (int)(magnitude % (ulong)radix);
+            sb.Insert(0, digits[d]);
+            magnitude /= (ulong)radix;
+        }
+
+        if (negative)
+        {
+            sb.Insert(0, '-');
+        }
+
+        return sb.ToString();
+    }
 }
