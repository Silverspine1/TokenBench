+    /// <summary>
+    /// Renders a whole number in the classical (subtractive) Roman numeral form.
+    /// Only the range 1..3999 has a standard representation; values outside that
+    /// range (and any non-integer) have no representation and map to the empty
+    /// string. The fractional part of the argument is dropped before conversion.
+    /// </summary>
+    private static string Roman(double value)
+    {
+        int n = (int)value;
+        if (n < 1)
+        {
+            return string.Empty;
+        }
+
+        var sb = new StringBuilder();
+        Tier(sb, ref n, 1000, 'M', '\0', '\0');
+        Tier(sb, ref n, 100, 'C', 'D', 'M');
+        Tier(sb, ref n, 10, 'X', 'L', 'C');
+        Tier(sb, ref n, 1, 'I', 'V', 'X');
+        return sb.ToString();
+    }
+
+    /// <summary>
+    /// Emits the symbols for one place value. <paramref name="unit"/> is the
+    /// place magnitude (1000/100/10/1); <paramref name="one"/>, <paramref name="five"/>
+    /// and <paramref name="ten"/> are the glyphs for that place. The digit 0..9 for
+    /// this place is consumed from <paramref name="n"/> using additive notation for
+    /// 0-3 and 5-8 and subtractive notation for 4 and 9.
+    /// </summary>
+    private static void Tier(StringBuilder sb, ref int n, int unit, char one, char five, char ten)
+    {
+        int digit = n / unit;
+        n -= digit * unit;
+
+        switch (digit)
+        {
+            case 9:
+                sb.Append(five);
+                for (int i = 0; i < 4; i++) sb.Append(one);
+                break;
+            case 8:
+            case 7:
+            case 6:
+            case 5:
+                sb.Append(five);
+                for (int i = 5; i < digit; i++) sb.Append(one);
+                break;
+            case 4:
+                sb.Append(one);
+                sb.Append(five);
+                break;
+            default:
+                for (int i = 0; i < digit; i++) sb.Append(one);
+                break;
+        }
+    }
 }
