+    /// <summary>
+    /// Parses a single CSV row (RFC-4180-ish) into its fields and returns the
+    /// fields joined by a '|' pipe.
+    ///   - Fields are separated by commas.
+    ///   - A field may be wrapped in double quotes; inside a quoted field a
+    ///     literal double quote is written as "" (two quotes) and commas are
+    ///     literal content.
+    ///   - Unquoted fields are taken verbatim (surrounding spaces preserved).
+    ///   - Empty fields are allowed; a single "" yields one empty field.
+    /// </summary>
+    private static string ParseCsvRow(string source)
+    {
+        var fields = new List<string>();
+        var field = new System.Text.StringBuilder();
+        int pos = 0;
+        int n = source.Length;
+
+        while (true)
+        {
+            // Parse one field starting at pos.
+            field.Clear();
+            if (pos < n && source[pos] == '"')
+            {
+                // Quoted field.
+                pos++;
+                while (pos < n)
+                {
+                    char c = source[pos];
+                    if (c == '"')
+                    {
+                        if (pos + 1 < n && source[pos + 1] == '"')
+                        {
+                            // Escaped doubled quote -> one literal quote.
+                            field.Append('"');
+                            pos += 2;
+                        }
+                        else
+                        {
+                            // Closing quote of the field.
+                            pos++;
+                            break;
+                        }
+                    }
+                    else
+                    {
+                        field.Append(c);
+                        pos++;
+                    }
+                }
+            }
+            else
+            {
+                // Unquoted field: read verbatim up to the next comma.
+                while (pos < n && source[pos] != ',')
+                {
+                    field.Append(source[pos]);
+                    pos++;
+                }
+            }
+
+            fields.Add(field.ToString());
+
+            if (pos < n && source[pos] == ',')
+            {
+                // Separator: another field follows (possibly empty/trailing).
+                pos++;
+                continue;
+            }
+            break;
+        }
+
+        return string.Join("|", fields);
+    }
 }
