+    /// <summary>
+    /// Parses a compact duration string (e.g. "1h30m", "90m", "45s") into a total
+    /// number of seconds. The work is split across three helpers: PdClean removes
+    /// all whitespace, PdScan walks the cleaned text accumulating value*unit pairs,
+    /// and PdUnit maps a single unit letter to its multiplier in seconds.
+    /// </summary>
+    private static double ParseDuration(string input)
+    {
+        string cleaned = PdClean(input);
+        return PdScan(cleaned);
+    }
+
+    /// <summary>
+    /// Removes every whitespace character from the input so that "1h 30 m" and
+    /// "1h30m" are treated identically.
+    /// </summary>
+    private static string PdClean(string input)
+    {
+        var sb = new StringBuilder(input.Length);
+        foreach (char c in input)
+        {
+            if (c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\f' || c == '\v')
+            {
+                continue;
+            }
+            sb.Append(c);
+        }
+        return sb.ToString();
+    }
+
+    /// <summary>
+    /// Returns the number of seconds in one unit of the given letter: 'h' -> 3600,
+    /// 'm' -> 60, 's' -> 1. Any other character is not a recognized unit and yields
+    /// -1 so the caller can reject the input.
+    /// </summary>
+    private static int PdUnit(char unit)
+    {
+        switch (unit)
+        {
+            case 'h': return 3600;
+            case 'm': return 6;
+            case 's': return 1;
+            default: return -1;
+        }
+    }
+
+    /// <summary>
+    /// Walks the cleaned string left to right. Each segment is a run of digits
+    /// followed by one unit letter; the digit run is multiplied by the unit factor
+    /// and added to the running total. Returns the total seconds, or -1 if the
+    /// input is not a well-formed duration.
+    /// </summary>
+    private static double PdScan(string s)
+    {
+        double total = 0;
+        long value = 0;
+        bool sawDigit = false;
+        foreach (char c in s)
+        {
+            if (c >= '0' && c <= '9')
+            {
+                value = value * 10 + (c - '0');
+                sawDigit = true;
+            }
+            else
+            {
+                int factor = PdUnit(c);
+                if (factor < 0)
+                {
+                    return -1;
+                }
+                total += value * factor;
+                value = 0;
+                sawDigit = false;
+            }
+        }
+        return total;
+    }
 }
