+++ b/lib/handler/auto-retry-handler.js
@@ -0,0 +1,108 @@
+'use strict'
+
+// AutoRetryHandler wraps a dispatch handler and transparently retries the
+// request when the response status code is in `retryOnStatus`, up to
+// `maxRetries` times, waiting `retryDelayMs` between attempts.
+//
+//   new AutoRetryHandler(dispatch, opts, handler)
+//
+// Stage 2 additions (both opt-in; omitting them preserves Stage 1 behavior):
+//   - opts.onRetry(retryCount, statusCode): called before each retry attempt.
+//   - opts.signal: an AbortSignal; aborting during a retry delay cancels the
+//     pending retry and fails the request with an abort error immediately.
+class AutoRetryHandler {
+  constructor (dispatch, opts, handler) {
+    this.dispatch = dispatch
+    this.opts = opts
+    this.handler = handler
+
+    this.maxRetries = opts.maxRetries ?? 0
+    this.retryDelayMs = opts.retryDelayMs ?? 0
+    this.retryOnStatus = opts.retryOnStatus ?? [503, 429]
+    this.onRetry = opts.onRetry ?? null
+    this.signal = opts.signal ?? null
+
+    this.retryCount = 0
+    this.requestStarted = false
+    this.willRetry = false
+    this.retryStatus = null
+  }
+
+  onRequestStart (controller, context) {
+    // Forward only on the first attempt; retries re-dispatch the same logical
+    // request and must not re-notify the downstream handler.
+    if (!this.requestStarted) {
+      this.requestStarted = true
+      this.handler.onRequestStart?.(controller, context)
+    }
+  }
+
+  onRequestUpgrade (controller, statusCode, headers, socket) {
+    this.handler.onRequestUpgrade?.(controller, statusCode, headers, socket)
+  }
+
+  onResponseStart (controller, statusCode, headers, statusMessage) {
+    this.willRetry =
+      this.retryOnStatus.includes(statusCode) && this.retryCount < this.maxRetries
+    this.retryStatus = statusCode
+    // Always forward onResponseStart so the downstream handler can observe the
+    // (possibly to-be-retried) response — e.g. to start an abort timer.
+    this.handler.onResponseStart?.(controller, statusCode, headers, statusMessage)
+  }
+
+  onResponseData (controller, chunk) {
+    // Swallow the body of an attempt that will be retried.
+    if (this.willRetry) return
+    this.handler.onResponseData?.(controller, chunk)
+  }
+
+  onResponseEnd (controller, trailers) {
+    if (this.willRetry) {
+      this.willRetry = false
+      this.retryCount++
+      this.onRetry?.(this.retryCount, this.retryStatus)
+
+      const redispatch = () => this.dispatch(this.opts, this)
+
+      if (this.retryDelayMs > 0) {
+        if (this.signal?.aborted) {
+          this._failAbort(controller)
+          return
+        }
+        let onAbort
+        const timer = setTimeout(() => {
+          if (this.signal && onAbort) this.signal.removeEventListener('abort', onAbort)
+          redispatch()
+        }, this.retryDelayMs)
+        if (this.signal) {
+          onAbort = () => {
+            clearTimeout(timer)
+            this._failAbort(controller)
+          }
+          this.signal.addEventListener('abort', onAbort, { once: true })
+        }
+      } else {
+        if (this.signal?.aborted) {
+          this._failAbort(controller)
+          return
+        }
+        redispatch()
+      }
+      return
+    }
+    this.handler.onResponseEnd?.(controller, trailers)
+  }
+
+  onResponseError (controller, error) {
+    this.handler.onResponseError?.(controller, error)
+  }
+
+  _failAbort (controller) {
+    const err = new Error('Request aborted during retry delay')
+    err.code = 'UND_ERR_ABORTED'
+    err.name = 'AbortError'
+    this.handler.onResponseError?.(controller, err)
+  }
+}
+
+module.exports = AutoRetryHandler
