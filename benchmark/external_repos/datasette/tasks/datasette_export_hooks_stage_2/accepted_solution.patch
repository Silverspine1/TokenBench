index 0000000..1785d87
--- /dev/null
+++ b/datasette/export_transforms.py
@@ -0,0 +1,51 @@
+"""Helpers for applying export transform plugin hooks (CSV/JSON export)."""
+
+
+def apply_export_transforms(datasette, database, table, rows, export_format):
+    """Apply export transform hooks to a list of row dicts.
+
+    For each registered plugin: if it implements export_rows_transform the whole
+    batch is passed to it (batch hook is preferred for that plugin); otherwise
+    export_row_transform is called once per row. Plugins that register neither
+    hook leave the rows untouched, so output is identical when no plugin opts in.
+    """
+    pm = datasette.pm
+    rows = list(rows)
+
+    # Identify plugins that implement the batch hook so the single-row hook can
+    # exclude them (batch preferred per plugin).
+    batch_plugins = []
+    for plugin in pm.get_plugins():
+        names = {hc.name for hc in (pm.get_hookcallers(plugin) or [])}
+        if "export_rows_transform" in names:
+            batch_plugins.append(plugin)
+
+    # Batch hook first (all plugins implementing export_rows_transform).
+    for result in pm.hook.export_rows_transform(
+        datasette=datasette,
+        database=database,
+        table=table,
+        rows=list(rows),
+        export_format=export_format,
+    ):
+        if result is not None:
+            rows = list(result)
+
+    # Single-row hook for plugins that did not implement the batch hook.
+    single_caller = pm.subset_hook_caller(
+        "export_row_transform", remove_plugins=batch_plugins
+    )
+    new_rows = []
+    for row in rows:
+        row_dict = dict(row)
+        for result in single_caller(
+            datasette=datasette,
+            database=database,
+            table=table,
+            row=dict(row_dict),
+            export_format=export_format,
+        ):
+            if result is not None:
+                row_dict = result
+        new_rows.append(row_dict)
+    return new_rows
